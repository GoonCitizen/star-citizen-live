# GoonCitizen LiveRelay on the dedicated relay.goon.vc address.
# DNS: relay.goon.vc → 65.21.231.149
# Copy to the repo-root `.env` (gitignored) or the pm2 process environment.
# Do not commit secrets. See docs/PRODUCTION.md.

NODE_ENV=production
SC_MODE=server

# --- Identity (REQUIRED; back up offline) ---
# Prefer FABRIC_XPRV so Hub / desktop / this relay share one operator key.
# FABRIC_XPRV=
# FABRIC_SEED=
# FABRIC_MNEMONIC=

# --- HTTP (Caddy or Nginx terminates TLS → loopback) ---
PORT=3041
FABRIC_HUB_INTERFACE=127.0.0.1
# Bare public HTTP (no reverse proxy) — bind the dedicated NIC instead:
# FABRIC_HUB_INTERFACE=65.21.231.149

# --- Fabric Peer (TCP/NOISE :7777) ---
# Port plan on this host: :7777 = hub.fabric.pub + relay.goon.vc;
# :7778+ = other apps (Sensemaker, Jeeves, …). Leave SC_FABRIC unset (Peer on).
# SC_FABRIC=0 is HTTP-only (not a mesh seed).
FABRIC_PORT=7777
FABRIC_INTERFACE=65.21.231.149
FABRIC_PUBLIC_HOST=relay.goon.vc

# --- Mission register ---
# Comma-separated officer pubkeys. Empty allowlist denies officer mutations.
# SC_OFFICERS=
# SC_ROSTER=

# --- Optional Discord bot ---
# DISCORD_BOT_TOKEN=
# DISCORD_APP_ID=
# DISCORD_APP_SECRET=
# DISCORD_CHANNEL_ID=
