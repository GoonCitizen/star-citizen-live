{
  "name": "@rsi/star-citizen",
  "version": "0.1.0-dev",
  "description": "Fabric connectivity for the Star Citizen universe with Discord integration.",
  "main": "main.js",
  "exports": {
    ".": "./app/server.js",
    "./parser": "./app/parser.js",
    "./types/Mission": "./types/Mission.js"
  },
  "scripts": {
    "backfill": "node scripts/backfill.js",
    "build:browser": "node scripts/build.js",
    "build:electron": "npm run build:browser && electron-builder",
    "build:win:installer": "npm run build:browser && electron-builder --win --publish never",
    "build:win": "npm run build:browser && electron-builder --win",
    "build": "npm run make:api && npm run build:browser",
    "coverage": "c8 npm test",
    "electron:dev": "electron . --dev",
    "electron": "electron .",
    "make:api": "jsdoc2md --configure jsdoc.json --files types/*.js services/*.js README.md > API.md",
    "replay": "node scripts/replay.js",
    "report:install": "rm -rf node_modules && echo \"\n\" > package-lock.json && echo \"$ npm i\" > reports/install.log && npm i >> reports/install.log",
    "report:todo": "grep --exclude package.json --exclude-dir=.env --exclude-dir=.git --exclude-dir=_book --exclude-dir=stores --exclude-dir=assets --exclude-dir=node_modules --exclude-dir=reports --exclude-dir=coverage --exclude-dir=docs --exclude-dir=libraries -rEI \"TODO|FIXME\" . | sed 's/\\([^:]*:\\)[ ]*/\\1 /' > reports/TODO.txt",
    "start:browser": "node app/server.js",
    "start:fabric": "node scripts/node.js   # DEPRECATED original Fabric-based entry (kept for reference)",
    "start": "node scripts/node.js",
    "test:browser": "node --test test/*.test.js",
    "test": "mocha tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoonCitizen/star-citizen-live.git"
  },
  "keywords": [
    "star",
    "citizen",
    "fabric",
    "bitcoin",
    "discord",
    "gaming",
    "rsi",
    "missions",
    "secp256k1",
    "musig2",
    "multisig",
    "contracts"
  ],
  "author": "Fabric Labs",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/GoonCitizen/star-citizen-live/issues"
  },
  "homepage": "https://github.com/GoonCitizen/star-citizen-live#readme",
  "dependencies": {
    "@fabric/hub": "FabricLabs/hub.fabric.pub#feature/sensemaker",
    "cross-fetch": "=4.0.0",
    "lodash.merge": "=4.6.2",
    "screenshot-desktop": "=1.15.1",
    "tail": "=2.2.6"
  },
  "devDependencies": {
    "electron": "=28.0.0",
    "electron-builder": "=24.9.1",
    "jsdoc-to-markdown": "=9.0.5",
    "mocha": "=10.8.2",
    "c8": "=7.11.3"
  },
  "build": {
    "appId": "com.rsi.star-citizen-live",
    "productName": "Star Citizen Live",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "RSI"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
